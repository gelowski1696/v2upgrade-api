model SocialAttribution {
  id                  String              @id @default(uuid()) @db.Uuid
  connectionId        String              @map("connection_id") @db.Uuid
  campaignId          String              @map("campaign_id") @db.Uuid
  conversationId      String?             @map("conversation_id") @db.Uuid
  quoteId             String?             @map("quote_id") @db.Uuid
  localOrderReference String?             @map("local_order_reference") @db.VarChar(120)
  method              String              @db.VarChar(40)
  revenueMinor        Int                 @default(0) @map("revenue_minor")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  connection          SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  campaign            SocialCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversation        SocialConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quote               SocialQuote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([campaignId, localOrderReference])
  @@index([connectionId, createdAt])
  @@map("social_attributions")
}

model StoreSnapshot {
  id                 String         @id @default(uuid()) @db.Uuid
  storeId            String         @map("store_id") @db.Uuid
  deviceId           String         @map("device_id") @db.Uuid
  schemaVersion      Int            @map("schema_version")
  applicationVersion String         @map("application_version") @db.VarChar(40)
  fileName           String         @map("file_name") @db.VarChar(255)
  fileSize           BigInt         @map("file_size")
  sha256             String         @db.Char(64)
  status             SnapshotStatus @default(STAGING)
  snapshotCreatedAt  DateTime       @map("snapshot_created_at") @db.Timestamptz(3)
  uploadedAt         DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  activatedAt        DateTime?      @map("activated_at") @db.Timestamptz(3)
  rejectionCode      String?        @map("rejection_code") @db.VarChar(80)
  rejectionMessage   String?        @map("rejection_message")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  store              Store          @relation("StoreSnapshots", fields: [storeId], references: [id], onDelete: Cascade)
  device             Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  activeForStore     Store?         @relation("ActiveStoreSnapshot")

  @@unique([storeId, sha256])
  @@index([storeId, status, uploadedAt])
  @@map("store_snapshots")
}

model SyncUploadSession {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @map("store_id") @db.Uuid
  deviceId           String              @map("device_id") @db.Uuid
  expectedSize       BigInt              @map("expected_size")
  expectedSha256     String              @map("expected_sha256") @db.Char(64)
  schemaVersion      Int                 @map("schema_version")
  applicationVersion String              @map("application_version") @db.VarChar(40)
  snapshotCreatedAt  DateTime            @map("snapshot_created_at") @db.Timestamptz(3)
  status             UploadSessionStatus @default(CREATED)
  expiresAt          DateTime            @map("expires_at") @db.Timestamptz(3)
  receivedBytes      BigInt              @default(0) @map("received_bytes")
  snapshotId         String?             @map("snapshot_id") @db.Uuid
  rejectionCode      String?             @map("rejection_code") @db.VarChar(80)
  rejectionMessage   String?             @map("rejection_message")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
  @@index([deviceId, status])
  @@map("sync_upload_sessions")
}

model LicenseLease {
  id             String        @id @default(uuid()) @db.Uuid
  tokenId        String        @unique @map("token_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  deviceId       String        @map("device_id") @db.Uuid
  status         LicenseStatus @default(ACTIVE)
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  validUntil     DateTime      @map("valid_until") @db.Timestamptz(3)
