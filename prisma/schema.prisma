generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum PaymentPurpose {
  INITIAL
  RENEWAL
  MODIFICATION
  OTHER
}

enum BillingStatementTarget {
  CLIENT
  GROUP
}

enum BillingStatementDeliveryStatus {
  PROCESSING
  SENT
  DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum ClientGroupStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  DRAFT
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PortalRole {
  OWNER
  MANAGER
  VIEWER
}

enum PortalUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum PortalReportFrequency {
  DAILY
  WEEKLY
}

enum PortalReportDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
}

enum SnapshotStatus {
  STAGING
  VALIDATING
  READY
  ACTIVE
  REJECTED
  RETIRED
}

enum UploadSessionStatus {
  CREATED
  UPLOADING
  UPLOADED
  VALIDATING
  COMPLETE
  REJECTED
  CANCELLED
  EXPIRED
}

enum WebAnalyticsEventType {
  PAGE_VIEW
  FEATURE_USED
  FRONTEND_ERROR
  API_FAILURE
  WEB_VITAL
}

enum WebAnalyticsDeviceClass {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum WebAnalyticsBrowserFamily {
  CHROME
  EDGE
  FIREFOX
  SAFARI
  OTHER
}

enum WebVitalName {
  LCP
  INP
  CLS
}

enum SocialConnectionStatus {
  ACTIVE
  ACTION_REQUIRED
  DISCONNECTED
}

enum SocialOauthStatus {
  PENDING
  AWAITING_PAGE
  COMPLETE
  FAILED
  EXPIRED
}

enum SocialPostStatus {
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialConversationStatus {
  OPEN
  WAITING
  ASSIGNED
  RESOLVED
}

enum SocialMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum SocialMessageSender {
  CUSTOMER
  CASHIER
  BOT
  SYSTEM
}

enum SocialAutomationMode {
  OFF
  FAQ_ONLY
  ASSISTED
}

enum SocialQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  READY_TO_IMPORT
  IMPORTING
  IMPORTED
  COMPLETED
  EXPIRED
  CANCELLED
  IMPORT_FAILED
}

enum SocialCampaignStatus {
  SUGGESTED
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  username             String                     @unique @db.VarChar(80)
  displayName          String                     @map("display_name") @db.VarChar(160)
  passwordHash         String                     @map("password_hash") @db.VarChar(255)
  role                 UserRole                   @default(OPERATOR)
  status               UserStatus                 @default(ACTIVE)
  lastLoginAt          DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions      RefreshSession[]
  createdSubscriptions Subscription[]             @relation("SubscriptionCreatedBy")
  deletedSubscriptions Subscription[]             @relation("SubscriptionDeletedBy")
  subscriptionEvents   SubscriptionEvent[]        @relation("SubscriptionEventActor")
  paymentRecords       PaymentRecord[]            @relation("PaymentCreatedBy")
  voidedPayments       PaymentRecord[]            @relation("PaymentVoidedBy")
  clientGroupsCreated  ClientGroup[]              @relation("ClientGroupCreatedBy")
  renewalsCreated      SubscriptionRenewal[]      @relation("SubscriptionRenewalCreatedBy")
  expensesCreated      Expense[]                  @relation("ExpenseCreatedBy")
  billingStatements    BillingStatementDelivery[] @relation("BillingStatementCreatedBy")
  auditLogs            AuditLog[]

  @@map("users")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @map("token_hash") @db.VarChar(255)
  tokenFamilyId       String    @default(uuid()) @map("token_family_id") @db.Uuid
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  revokedReason       String?   @map("revoked_reason") @db.VarChar(40)
  browserSession      Boolean   @default(false) @map("browser_session")
  persistent          Boolean   @default(false)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("refresh_sessions")
}

model Client {
  id                  String                     @id @default(uuid()) @db.Uuid
  code                String                     @unique @db.VarChar(40)
  businessName        String                     @map("business_name") @db.VarChar(180)
  ownerName           String?                    @map("owner_name") @db.VarChar(160)
  email               String?                    @db.VarChar(180)
  billingEmail        String?                    @map("billing_email") @db.VarChar(180)
  phone               String?                    @db.VarChar(50)
  address             String?
  notes               String?
  status              ClientStatus               @default(ACTIVE)
  groupId             String?                    @map("group_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions       Subscription[]
  devices             Device[]
  stores              Store[]
  portalUsers         PortalUser[]
  invitations         PortalInvitation[]
  webAnalyticsEnabled Boolean                    @default(true) @map("web_analytics_enabled")
  webAnalyticsEvents  WebAnalyticsEvent[]
  group               ClientGroup?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  paymentRecords      PaymentRecord[]
  billingStatements   BillingStatementDelivery[]
  socialConnections   SocialConnection[]

  @@index([businessName])
  @@index([status])
  @@index([groupId, status])
  @@map("clients")
}

model ClientGroup {
  id                String                     @id @default(uuid()) @db.Uuid
  code              String                     @unique @db.VarChar(40)
  name              String                     @unique @db.VarChar(120)
  description       String?
  billingEmail      String?                    @map("billing_email") @db.VarChar(180)
  status            ClientGroupStatus          @default(ACTIVE)
  createdById       String                     @map("created_by_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         User                       @relation("ClientGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  clients           Client[]
  billingStatements BillingStatementDelivery[]

  @@index([status, name])
  @@map("client_groups")
}

model Store {
  id                 String                 @id @default(uuid()) @db.Uuid
  clientId           String                 @map("client_id") @db.Uuid
  code               String                 @db.VarChar(40)
  name               String                 @db.VarChar(180)
  status             StoreStatus            @default(ACTIVE)
  timezone           String                 @default("Asia/Manila") @db.VarChar(80)
  activeSnapshotId   String?                @unique @map("active_snapshot_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  devices            Device[]
  portalAccess       PortalStoreAccess[]
  invitations        PortalInvitation[]
  snapshots          StoreSnapshot[]        @relation("StoreSnapshots")
  activeSnapshot     StoreSnapshot?         @relation("ActiveStoreSnapshot", fields: [activeSnapshotId], references: [id], onDelete: SetNull)
  uploadSessions     SyncUploadSession[]
  reportSchedules    PortalReportSchedule[]
  salesTargets       PortalSalesTarget[]
  savedViews         PortalSavedView[]
  webAnalyticsEvents WebAnalyticsEvent[]
  socialConnections  SocialConnection[]

  @@unique([clientId, code])
  @@index([clientId, status])
  @@map("stores")
}

model PortalUser {
  id                  String                     @id @default(uuid()) @db.Uuid
  clientId            String                     @map("client_id") @db.Uuid
  username            String                     @unique @db.VarChar(180)
  displayName         String                     @map("display_name") @db.VarChar(160)
  passwordHash        String                     @map("password_hash") @db.VarChar(255)
  role                PortalRole                 @default(VIEWER)
  status              PortalUserStatus           @default(INVITED)
  passwordChangedAt   DateTime?                  @map("password_changed_at") @db.Timestamptz(3)
  emailVerifiedAt     DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt         DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  client              Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  storeAccess         PortalStoreAccess[]
  refreshSessions     PortalRefreshSession[]
  passwordResets      PortalPasswordReset[]
  alertDismissals     PortalAlertDismissal[]
  emailVerifications  PortalEmailVerification[]
  reportSchedules     PortalReportSchedule[]
  salesTargets        PortalSalesTarget[]
  dashboardPreference PortalDashboardPreference?
  savedViews          PortalSavedView[]
  webAnalyticsEvents  WebAnalyticsEvent[]

  @@index([clientId, status])
  @@map("portal_users")
}

model WebAnalyticsEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  eventKey        String                    @map("event_key") @db.Uuid
  eventType       WebAnalyticsEventType     @map("event_type")
  clientId        String                    @map("client_id") @db.Uuid
  storeId         String?                   @map("store_id") @db.Uuid
  portalUserId    String                    @map("portal_user_id") @db.Uuid
  portalSessionId String                    @map("portal_session_id") @db.Uuid
  portalRole      PortalRole                @map("portal_role")
  occurredAt      DateTime                  @map("occurred_at") @db.Timestamptz(3)
  route           String                    @db.VarChar(120)
  feature         String?                   @db.VarChar(60)
  operation       String?                   @db.VarChar(60)
  errorCode       String?                   @map("error_code") @db.VarChar(80)
  httpStatus      Int?                      @map("http_status")
  metricName      WebVitalName?             @map("metric_name")
  metricValue     Float?                    @map("metric_value")
  appRelease      String                    @map("app_release") @db.VarChar(64)
  deviceClass     WebAnalyticsDeviceClass   @map("device_class")
  browserFamily   WebAnalyticsBrowserFamily @map("browser_family")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  client          Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store           Store?                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  portalUser      PortalUser                @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, eventKey])
  @@index([clientId, occurredAt])
  @@index([clientId, eventType, occurredAt])
  @@index([storeId, occurredAt])
  @@index([appRelease, occurredAt])
  @@map("web_analytics_events")
}

model PortalAlertDismissal {
  id           String     @id @default(uuid()) @db.Uuid
  portalUserId String     @map("portal_user_id") @db.Uuid
  alertId      String     @map("alert_id") @db.VarChar(255)
  dismissedAt  DateTime   @default(now()) @map("dismissed_at") @db.Timestamptz(3)
  user         PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, alertId])
  @@index([portalUserId, dismissedAt])
  @@map("portal_alert_dismissals")
}

model PortalEmailVerification {
  id           String     @id @default(uuid()) @db.Uuid
  portalUserId String     @map("portal_user_id") @db.Uuid
  tokenHash    String     @map("token_hash") @db.Char(64)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?  @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user         PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, createdAt])
  @@map("portal_email_verifications")
}

model PortalReportSchedule {
  id            String                 @id @default(uuid()) @db.Uuid
  portalUserId  String                 @map("portal_user_id") @db.Uuid
  storeId       String                 @map("store_id") @db.Uuid
  frequency     PortalReportFrequency
  enabled       Boolean                @default(false)
  nextRunAt     DateTime?              @map("next_run_at") @db.Timestamptz(3)
  lastAttemptAt DateTime?              @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt DateTime?              @map("last_success_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          PortalUser             @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries    PortalReportDelivery[]

  @@unique([portalUserId, storeId, frequency])
  @@index([enabled, nextRunAt])
  @@map("portal_report_schedules")
}

model PortalReportDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  scheduleId        String                     @map("schedule_id") @db.Uuid
  periodFrom        String                     @map("period_from") @db.VarChar(10)
  periodTo          String                     @map("period_to") @db.VarChar(10)
  recipientEmail    String                     @map("recipient_email") @db.VarChar(180)
  status            PortalReportDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?                  @map("next_attempt_at") @db.Timestamptz(3)
  snapshotAgeHours  Int?                       @map("snapshot_age_hours")
  dataQualityStatus String?                    @map("data_quality_status") @db.VarChar(20)
  warning           String?                    @db.VarChar(255)
  errorCode         String?                    @map("error_code") @db.VarChar(80)
  providerMessageId String?                    @unique @map("provider_message_id") @db.VarChar(100)
  providerStatus    String?                    @map("provider_status") @db.VarChar(40)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule          PortalReportSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, periodFrom, periodTo])
  @@index([status, nextAttemptAt])
  @@index([scheduleId, createdAt])
  @@map("portal_report_deliveries")
}

model PortalSalesTarget {
  id                        String     @id @default(uuid()) @db.Uuid
  storeId                   String     @map("store_id") @db.Uuid
  month                     String     @db.VarChar(7)
  salesTarget               Decimal    @map("sales_target") @db.Decimal(14, 2)
  recordedGrossProfitTarget Decimal    @map("recorded_gross_profit_target") @db.Decimal(14, 2)
  updatedByPortalUserId     String     @map("updated_by_portal_user_id") @db.Uuid
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  store                     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy                 PortalUser @relation(fields: [updatedByPortalUserId], references: [id], onDelete: Restrict)

  @@unique([storeId, month])
  @@index([updatedByPortalUserId, updatedAt])
  @@map("portal_sales_targets")
}

model PortalDashboardPreference {
  portalUserId    String     @id @map("portal_user_id") @db.Uuid
  overviewMetrics Json       @map("overview_metrics")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@map("portal_dashboard_preferences")
}

model PortalSavedView {
  id           String     @id @default(uuid()) @db.Uuid
  portalUserId String     @map("portal_user_id") @db.Uuid
  storeId      String     @map("store_id") @db.Uuid
  name         String     @db.VarChar(80)
  report       String     @db.VarChar(60)
  datePreset   String     @map("date_preset") @db.VarChar(24)
  dateFrom     String?    @map("date_from") @db.VarChar(10)
  dateTo       String?    @map("date_to") @db.VarChar(10)
  filters      Json
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, name])
  @@index([portalUserId, updatedAt])
  @@index([storeId])
  @@map("portal_saved_views")
}

model PortalRefreshSession {
  id                  String     @id @default(uuid()) @db.Uuid
  portalUserId        String     @map("portal_user_id") @db.Uuid
  tokenHash           String     @map("token_hash") @db.VarChar(255)
  tokenFamilyId       String     @default(uuid()) @map("token_family_id") @db.Uuid
  replacedBySessionId String?    @map("replaced_by_session_id") @db.Uuid
  revokedReason       String?    @map("revoked_reason") @db.VarChar(40)
  userAgent           String?    @map("user_agent") @db.VarChar(500)
  ipAddress           String?    @map("ip_address") @db.VarChar(80)
  lastUsedAt          DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user                PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, revokedAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("portal_refresh_sessions")
}

model PortalPasswordReset {
  id                String     @id @default(uuid()) @db.Uuid
  portalUserId      String     @map("portal_user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?  @map("used_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdByDeviceId String     @map("created_by_device_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user              PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  createdByDevice   Device     @relation(fields: [createdByDeviceId], references: [id], onDelete: Restrict)

  @@index([portalUserId, expiresAt])
  @@map("portal_password_resets")
}

model PortalStoreAccess {
  portalUserId String      @map("portal_user_id") @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  roleOverride PortalRole? @map("role_override")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user         PortalUser  @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([portalUserId, storeId])
  @@index([storeId])
  @@map("portal_store_access")
}

model PortalInvitation {
  id                String     @id @default(uuid()) @db.Uuid
  clientId          String     @map("client_id") @db.Uuid
  storeId           String     @map("store_id") @db.Uuid
  storeIds          String[]   @default([]) @map("store_ids") @db.Uuid
  username          String     @db.VarChar(180)
  displayName       String     @map("display_name") @db.VarChar(160)
  role              PortalRole
  tokenHash         String     @unique @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt        DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdByDeviceId String?    @map("created_by_device_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdByDevice   Device?    @relation(fields: [createdByDeviceId], references: [id], onDelete: Restrict)

  @@index([clientId, username])
  @@index([storeId, expiresAt])
  @@map("portal_invitations")
}

model Plan {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(40)
  name      String        @db.VarChar(120)
  status    PlanStatus    @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions  PlanVersion[]

  @@index([status])
  @@map("plans")
}

model PlanVersion {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  version         Int
  billingInterval BillingInterval @map("billing_interval")
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("PHP") @db.Char(3)
  trialDays       Int             @default(0) @map("trial_days")
  graceDays       Int             @default(7) @map("grace_days")
  maxDevices      Int             @default(1) @map("max_devices")
  features        Json            @default("{}")
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions   Subscription[]

  @@unique([planId, version])
  @@index([planId, publishedAt])
  @@map("plan_versions")
}

model Subscription {
  id              String                @id @default(uuid()) @db.Uuid
  clientId        String                @map("client_id") @db.Uuid
  planVersionId   String                @map("plan_version_id") @db.Uuid
  status          SubscriptionStatus    @default(DRAFT)
  startsAt        DateTime              @map("starts_at") @db.Timestamptz(3)
  renewsAt        DateTime?             @map("renews_at") @db.Timestamptz(3)
  expiresAt       DateTime?             @map("expires_at") @db.Timestamptz(3)
  graceEndsAt     DateTime?             @map("grace_ends_at") @db.Timestamptz(3)
  suspendedAt     DateTime?             @map("suspended_at") @db.Timestamptz(3)
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?               @map("deleted_by_id") @db.Uuid
  amount          Decimal               @db.Decimal(12, 2)
  currency        String                @db.Char(3)
  billingInterval BillingInterval       @map("billing_interval")
  maxDevices      Int                   @map("max_devices")
  entitlements    Json                  @default("{}")
  notes           String?
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planVersion     PlanVersion           @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy       User?                 @relation("SubscriptionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  events          SubscriptionEvent[]
  devices         Device[]
  licenseLeases   LicenseLease[]
  paymentRecords  PaymentRecord[]
  renewals        SubscriptionRenewal[]

  @@index([clientId, status])
  @@index([status, expiresAt])
  @@index([deletedAt, status, createdAt])
  @@map("subscriptions")
}

model SubscriptionRenewal {
  id                String          @id @default(uuid()) @db.Uuid
  subscriptionId    String          @map("subscription_id") @db.Uuid
  previousExpiresAt DateTime?       @map("previous_expires_at") @db.Timestamptz(3)
  periodStartsAt    DateTime        @map("period_starts_at") @db.Timestamptz(3)
  periodEndsAt      DateTime        @map("period_ends_at") @db.Timestamptz(3)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  billingInterval   BillingInterval @map("billing_interval")
  reason            String?         @db.VarChar(500)
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("SubscriptionRenewalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paymentRecords    PaymentRecord[]

  @@index([subscriptionId, createdAt])
  @@map("subscription_renewals")
}

model SubscriptionEvent {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String?
  metadata       Json                @default("{}")
  actorId        String              @map("actor_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor          User                @relation("SubscriptionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model Device {
  id                   String                  @id @default(uuid()) @db.Uuid
  clientId             String                  @map("client_id") @db.Uuid
  subscriptionId       String?                 @map("subscription_id") @db.Uuid
  storeId              String                  @map("store_id") @db.Uuid
  installationId       String                  @unique @map("installation_id") @db.VarChar(120)
  fingerprintHash      String?                 @map("fingerprint_hash") @db.VarChar(255)
  label                String?                 @db.VarChar(120)
  platform             String                  @db.VarChar(40)
  appVersion           String?                 @map("app_version") @db.VarChar(40)
  status               DeviceStatus            @default(ACTIVE)
  lastSeenAt           DateTime?               @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime?               @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscription         Subscription?           @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  store                Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  licenseLeases        LicenseLease[]
  portalInvitations    PortalInvitation[]
  portalPasswordResets PortalPasswordReset[]
  snapshots            StoreSnapshot[]
  uploadSessions       SyncUploadSession[]
  socialOauthAttempts  SocialOauthAttempt[]
  socialPresence       SocialCashierPresence[]

  @@unique([subscriptionId])
  @@index([clientId, status])
  @@index([subscriptionId, status])
  @@index([storeId, status])
  @@map("devices")
}

model SocialConnection {
  id                 String                      @id @default(uuid()) @db.Uuid
  clientId           String                      @map("client_id") @db.Uuid
  storeId            String                      @map("store_id") @db.Uuid
  provider           String                      @default("META") @db.VarChar(20)
  pageId             String                      @map("page_id") @db.VarChar(120)
  pageName           String                      @map("page_name") @db.VarChar(180)
  status             SocialConnectionStatus      @default(ACTIVE)
  tokenCiphertext    String                      @map("token_ciphertext")
  tokenExpiresAt     DateTime?                   @map("token_expires_at") @db.Timestamptz(3)
  grantedPermissions String[]                    @default([]) @map("granted_permissions")
  pageTasks          String[]                    @default([]) @map("page_tasks")
  lastCheckedAt      DateTime?                   @map("last_checked_at") @db.Timestamptz(3)
  lastError          String?                     @map("last_error")
  connectedBy        String                      @map("connected_by") @db.VarChar(120)
  connectedAt        DateTime                    @default(now()) @map("connected_at") @db.Timestamptz(3)
  disconnectedAt     DateTime?                   @map("disconnected_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  client             Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  templates          SocialPostTemplate[]
  posts              SocialPost[]
  conversations      SocialConversation[]
  messages           SocialMessage[]
  webhookEvents      SocialWebhookEvent[]
  faqs               SocialFaq[]
  cashierPresence    SocialCashierPresence[]
  customerLinks      SocialCustomerLink[]
  quotes             SocialQuote[]
  commerceEvents     SocialCommerceEvent[]
  campaignRules      SocialCampaignRule[]
  campaignSignals    SocialCampaignSignal[]
  campaigns          SocialCampaign[]
  campaignMetrics    SocialCampaignMetricDaily[]
  attributions       SocialAttribution[]

  @@unique([storeId, pageId])
  @@index([clientId, storeId, status])
  @@map("social_connections")
}

model SocialOauthAttempt {
  id                  String            @id @default(uuid()) @db.Uuid
  clientId            String            @map("client_id") @db.Uuid
  storeId             String            @map("store_id") @db.Uuid
  deviceId            String            @map("device_id") @db.Uuid
  stateHash           String            @unique @map("state_hash") @db.Char(64)
  status              SocialOauthStatus @default(PENDING)
  actor               String            @db.VarChar(120)
  userTokenCiphertext String?           @map("user_token_ciphertext")
  pageCandidates      Json              @default("[]") @map("page_candidates")
  connectionId        String?           @map("connection_id") @db.Uuid
  errorMessage        String?           @map("error_message")
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  device              Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, createdAt])
  @@map("social_oauth_attempts")
}

model SocialPostTemplate {
  id           String           @id @default(uuid()) @db.Uuid
  connectionId String           @map("connection_id") @db.Uuid
  name         String           @db.VarChar(120)
  body         String
  autoPublish  Boolean          @default(false) @map("auto_publish")
  locked       Boolean          @default(false)
  createdBy    String           @map("created_by") @db.VarChar(120)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  posts        SocialPost[]

  @@unique([connectionId, name])
  @@index([connectionId, updatedAt])
  @@map("social_post_templates")
}

model SocialPost {
  id                 String              @id @default(uuid()) @db.Uuid
  connectionId       String              @map("connection_id") @db.Uuid
  templateId         String?             @map("template_id") @db.Uuid
  content            String
  status             SocialPostStatus    @default(DRAFT)
  scheduledAt        DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(3)
  providerPostId     String?             @map("provider_post_id") @db.VarChar(180)
  idempotencyKey     String              @unique @map("idempotency_key") @db.VarChar(120)
  createdBy          String              @map("created_by") @db.VarChar(120)
  approvedBy         String?             @map("approved_by") @db.VarChar(120)
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(3)
  attemptCount       Int                 @default(0) @map("attempt_count")
  lastAttemptAt      DateTime?           @map("last_attempt_at") @db.Timestamptz(3)
  lastError          String?             @map("last_error")
  generationMetadata Json                @default("{}") @map("generation_metadata")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection         SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  template           SocialPostTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([connectionId, status, scheduledAt])
  @@map("social_posts")
}

model SocialConversation {
  id                    String                   @id @default(uuid()) @db.Uuid
  connectionId          String                   @map("connection_id") @db.Uuid
  participantId         String                   @map("participant_id") @db.VarChar(180)
  participantName       String?                  @map("participant_name") @db.VarChar(180)
  participantPictureUrl String?                  @map("participant_picture_url")
  status                SocialConversationStatus @default(OPEN)
  automationMode        SocialAutomationMode     @default(FAQ_ONLY) @map("automation_mode")
  assignedTo            String?                  @map("assigned_to") @db.VarChar(120)
  assignedAt            DateTime?                @map("assigned_at") @db.Timestamptz(3)
  lastInboundAt         DateTime?                @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt         DateTime                 @default(now()) @map("last_message_at") @db.Timestamptz(3)
  unreadCount           Int                      @default(0) @map("unread_count")
  resolvedAt            DateTime?                @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection            SocialConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages              SocialMessage[]
  customerLink          SocialCustomerLink?
  quotes                SocialQuote[]
  attributions          SocialAttribution[]

  @@unique([connectionId, participantId])
  @@index([connectionId, status, lastMessageAt])
  @@map("social_conversations")
}

model SocialMessage {
  id                String                 @id @default(uuid()) @db.Uuid
  connectionId      String                 @map("connection_id") @db.Uuid
  conversationId    String                 @map("conversation_id") @db.Uuid
  providerMessageId String?                @map("provider_message_id") @db.VarChar(220)
  direction         SocialMessageDirection
  sender            SocialMessageSender
  senderName        String?                @map("sender_name") @db.VarChar(120)
  text              String?
  attachments       Json                   @default("[]")
  deliveryStatus    String                 @default("RECEIVED") @map("delivery_status") @db.VarChar(30)
  sentAt            DateTime               @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  connection        SocialConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation      SocialConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerMessageId])
  @@index([conversationId, sentAt])
  @@map("social_messages")
}

model SocialFaq {
  id           String           @id @default(uuid()) @db.Uuid
  connectionId String           @map("connection_id") @db.Uuid
  question     String           @db.VarChar(240)
  answer       String
  keywords     String[]         @default([])
  enabled      Boolean          @default(true)
  createdBy    String           @map("created_by") @db.VarChar(120)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, enabled])
  @@map("social_faqs")
}

model SocialCashierPresence {
  id           String           @id @default(uuid()) @db.Uuid
  connectionId String           @map("connection_id") @db.Uuid
  deviceId     String           @map("device_id") @db.Uuid
  username     String           @db.VarChar(120)
  displayName  String           @map("display_name") @db.VarChar(160)
  availability String           @default("AVAILABLE") @db.VarChar(20)
  lastSeenAt   DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([connectionId, deviceId, username])
  @@index([connectionId, availability, lastSeenAt])
  @@map("social_cashier_presence")
}

model SocialWebhookEvent {
  id                  String            @id @default(uuid()) @db.Uuid
  connectionId        String?           @map("connection_id") @db.Uuid
  eventHash           String            @unique @map("event_hash") @db.Char(64)
  status              String            @default("RECEIVED") @db.VarChar(30)
  payload             Json
  attemptCount        Int               @default(0) @map("attempt_count")
  lastError           String?           @map("last_error")
  receivedAt          DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz(3)
  processedAt         DateTime?         @map("processed_at") @db.Timestamptz(3)
  connection          SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@map("social_webhook_events")
}

model SocialCustomerLink {
  id              String             @id @default(uuid()) @db.Uuid
  connectionId    String             @map("connection_id") @db.Uuid
  conversationId  String             @unique @map("conversation_id") @db.Uuid
  posCustomerId   Int                @map("pos_customer_id")
  customerName    String             @map("customer_name") @db.VarChar(180)
  customerContact String?            @map("customer_contact") @db.VarChar(80)
  verifiedMethod  String             @default("CASHIER_CONFIRMED") @map("verified_method") @db.VarChar(40)
  linkedBy        String             @map("linked_by") @db.VarChar(120)
  linkedAt        DateTime           @default(now()) @map("linked_at") @db.Timestamptz(3)
  unlinkedAt      DateTime?          @map("unlinked_at") @db.Timestamptz(3)
  connection      SocialConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation    SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quotes          SocialQuote[]

  @@index([connectionId, posCustomerId])
  @@map("social_customer_links")
}

model SocialQuote {
  id                  String                @id @default(uuid()) @db.Uuid
  connectionId        String                @map("connection_id") @db.Uuid
  conversationId      String                @map("conversation_id") @db.Uuid
  customerLinkId      String?               @map("customer_link_id") @db.Uuid
  sourceCampaignId    String?               @map("source_campaign_id") @db.Uuid
  status              SocialQuoteStatus     @default(DRAFT)
  currency            String                @default("PHP") @db.Char(3)
  subtotalMinor       Int                   @default(0) @map("subtotal_minor")
  adjustmentMinor     Int                   @default(0) @map("adjustment_minor")
  totalMinor          Int                   @default(0) @map("total_minor")
  notes               String                @default("")
  sourceSnapshotId    String?               @map("source_snapshot_id") @db.Uuid
  sourceSnapshotAt    DateTime?             @map("source_snapshot_at") @db.Timestamptz(3)
  idempotencyKey      String                @unique @map("idempotency_key") @db.VarChar(120)
  createdBy           String                @map("created_by") @db.VarChar(120)
  approvedBy          String?               @map("approved_by") @db.VarChar(120)
  expiresAt           DateTime?             @map("expires_at") @db.Timestamptz(3)
  sentAt              DateTime?             @map("sent_at") @db.Timestamptz(3)
  acceptedAt          DateTime?             @map("accepted_at") @db.Timestamptz(3)
  importClaimedBy     String?               @map("import_claimed_by") @db.VarChar(120)
  importClaimedAt     DateTime?             @map("import_claimed_at") @db.Timestamptz(3)
  localQueueId        Int?                  @map("local_queue_id")
  localQueueReference String?               @map("local_queue_reference") @db.VarChar(120)
  importedAt          DateTime?             @map("imported_at") @db.Timestamptz(3)
  completedAt         DateTime?             @map("completed_at") @db.Timestamptz(3)
  lastError           String?               @map("last_error")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection          SocialConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation        SocialConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerLink        SocialCustomerLink?   @relation(fields: [customerLinkId], references: [id], onDelete: SetNull)
  sourceCampaign      SocialCampaign?       @relation(fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  lines               SocialQuoteLine[]
  events              SocialCommerceEvent[]
  attributions        SocialAttribution[]

  @@index([connectionId, status, updatedAt])
  @@index([conversationId, createdAt])
  @@map("social_quotes")
}

model SocialQuoteLine {
  id               String      @id @default(uuid()) @db.Uuid
  quoteId          String      @map("quote_id") @db.Uuid
  posItemId        Int         @map("pos_item_id")
  itemCode         String      @map("item_code") @db.VarChar(120)
  itemName         String      @map("item_name") @db.VarChar(240)
  itemSize         String      @default("") @map("item_size") @db.VarChar(120)
  unit             String      @default("NON-REFILL") @db.VarChar(30)
  quantity         Int
  unitPriceMinor   Int         @map("unit_price_minor")
  lineTotalMinor   Int         @map("line_total_minor")
  sourceSnapshotId String?     @map("source_snapshot_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  quote            SocialQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("social_quote_lines")
}

model SocialCommerceEvent {
  id           String           @id @default(uuid()) @db.Uuid
  connectionId String           @map("connection_id") @db.Uuid
  quoteId      String?          @map("quote_id") @db.Uuid
  eventType    String           @map("event_type") @db.VarChar(60)
  actor        String           @db.VarChar(120)
  deviceId     String?          @map("device_id") @db.Uuid
  metadata     Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  quote        SocialQuote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([quoteId, createdAt])
  @@map("social_commerce_events")
}

model SocialCampaignRule {
  id           String                 @id @default(uuid()) @db.Uuid
  connectionId String                 @map("connection_id") @db.Uuid
  name         String                 @db.VarChar(160)
  triggerType  String                 @map("trigger_type") @db.VarChar(60)
  thresholds   Json                   @default("{}")
  cooldownDays Int                    @default(14) @map("cooldown_days")
  enabled      Boolean                @default(true)
  autoSchedule Boolean                @default(false) @map("auto_schedule")
  createdBy    String                 @map("created_by") @db.VarChar(120)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection   SocialConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  signals      SocialCampaignSignal[]

  @@unique([connectionId, name])
  @@index([connectionId, enabled])
  @@map("social_campaign_rules")
}

model SocialCampaignSignal {
  id                String              @id @default(uuid()) @db.Uuid
  connectionId      String              @map("connection_id") @db.Uuid
  ruleId            String?             @map("rule_id") @db.Uuid
  signalType        String              @map("signal_type") @db.VarChar(60)
  sourceSnapshotId  String?             @map("source_snapshot_id") @db.Uuid
  facts             Json                @default("{}")
  eligible          Boolean             @default(true)
  suppressionReason String?             @map("suppression_reason")
  detectedAt        DateTime            @default(now()) @map("detected_at") @db.Timestamptz(3)
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz(3)
  connection        SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rule              SocialCampaignRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  campaigns         SocialCampaign[]

  @@index([connectionId, eligible, detectedAt])
  @@map("social_campaign_signals")
}

model SocialCampaign {
  id           String                      @id @default(uuid()) @db.Uuid
  connectionId String                      @map("connection_id") @db.Uuid
  signalId     String?                     @map("signal_id") @db.Uuid
  name         String                      @db.VarChar(180)
  goal         String                      @db.VarChar(120)
  status       SocialCampaignStatus        @default(DRAFT)
  facts        Json                        @default("{}")
  trackingCode String                      @unique @map("tracking_code") @db.VarChar(40)
  createdBy    String                      @map("created_by") @db.VarChar(120)
  approvedBy   String?                     @map("approved_by") @db.VarChar(120)
  approvedAt   DateTime?                   @map("approved_at") @db.Timestamptz(3)
  startsAt     DateTime?                   @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?                   @map("ends_at") @db.Timestamptz(3)
  pausedAt     DateTime?                   @map("paused_at") @db.Timestamptz(3)
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection   SocialConnection            @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  signal       SocialCampaignSignal?       @relation(fields: [signalId], references: [id], onDelete: SetNull)
  variants     SocialCampaignVariant[]
  quotes       SocialQuote[]
  metrics      SocialCampaignMetricDaily[]
  attributions SocialAttribution[]

  @@index([connectionId, status, updatedAt])
  @@map("social_campaigns")
}

model SocialCampaignVariant {
  id                 String         @id @default(uuid()) @db.Uuid
  campaignId         String         @map("campaign_id") @db.Uuid
  content            String
  factsHash          String         @map("facts_hash") @db.Char(64)
  provider           String         @default("TEMPLATE") @db.VarChar(60)
  model              String         @default("") @db.VarChar(120)
  validationPassed   Boolean        @default(false) @map("validation_passed")
  validationMessages String[]       @default([]) @map("validation_messages")
  selected           Boolean        @default(false)
  postId             String?        @map("post_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  campaign           SocialCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, selected])
  @@map("social_campaign_variants")
}

model SocialCampaignMetricDaily {
