  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@index([deviceId, status])
  @@map("license_leases")
}

model PaymentRecord {
  id             String               @id @default(uuid()) @db.Uuid
  batchId        String?              @map("batch_id") @db.Uuid
  clientId       String               @map("client_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  renewalId      String?              @map("renewal_id") @db.Uuid
  purpose        PaymentPurpose       @default(OTHER)
  description    String?              @db.VarChar(250)
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("PHP") @db.Char(3)
  reference      String?              @db.VarChar(120)
  paidAt         DateTime             @map("paid_at") @db.Timestamptz(3)
  notes          String?
  status         PaymentStatus        @default(POSTED)
  voidedAt       DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidedById     String?              @map("voided_by_id") @db.Uuid
  voidReason     String?              @map("void_reason") @db.VarChar(250)
  createdById    String               @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscription   Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  renewal        SubscriptionRenewal? @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  createdBy      User                 @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy       User?                @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([subscriptionId, paidAt])
  @@index([batchId])
  @@index([clientId, paidAt])
  @@index([renewalId])
  @@index([purpose, paidAt, currency])
  @@index([paidAt, currency])
  @@index([status, paidAt, currency])
  @@map("payment_records")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(40)
  description String   @db.VarChar(160)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PHP") @db.Char(3)
  incurredAt  DateTime @map("incurred_at") @db.Timestamptz(3)
  vendor      String?  @db.VarChar(160)
  reference   String?  @db.VarChar(120)
  notes       String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([incurredAt, currency])
  @@index([category, incurredAt])
  @@map("expenses")
}

model BillingStatementDelivery {
  id                String                         @id @default(uuid()) @db.Uuid
  targetType        BillingStatementTarget         @map("target_type")
  clientId          String?                        @map("client_id") @db.Uuid
  groupId           String?                        @map("group_id") @db.Uuid
  recipientEmail    String                         @map("recipient_email") @db.VarChar(180)
  subject           String                         @db.VarChar(180)
  statementDate     String                         @map("statement_date") @db.VarChar(10)
  dueDate           String?                        @map("due_date") @db.VarChar(10)
  currency          String                         @default("PHP") @db.Char(3)
  totalAmount       Decimal                        @map("total_amount") @db.Decimal(12, 2)
  lineItems         Json                           @map("line_items")
  status            BillingStatementDeliveryStatus @default(PROCESSING)
  providerMessageId String?                        @unique @map("provider_message_id") @db.VarChar(100)
  providerStatus    String?                        @map("provider_status") @db.VarChar(40)
  errorCode         String?                        @map("error_code") @db.VarChar(80)
  sentAt            DateTime?                      @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?                      @map("delivered_at") @db.Timestamptz(3)
  createdById       String                         @map("created_by_id") @db.Uuid
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  client            Client?                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  group             ClientGroup?                   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy         User                           @relation("BillingStatementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([groupId, createdAt])
  @@index([status, createdAt])
  @@map("billing_statement_deliveries")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(80)
  requestId    String?  @map("request_id") @db.VarChar(80)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
