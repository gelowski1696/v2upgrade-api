NODE_ENV=development
SWAGGER_ENABLED=true
PORT=3100
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/posv2_subscription
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
DEVICE_JWT_SECRET=replace_with_a_device_secret_at_least_32_characters
PORTAL_JWT_ACCESS_SECRET=replace_with_a_portal_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REMEMBER_LOGIN_TTL_DAYS=30
ADMIN_BROWSER_SESSION_TTL_HOURS=24
ADMIN_REFRESH_REUSE_GRACE_SECONDS=5
LICENSE_LEASE_DAYS=7
DEVICE_TOKEN_TTL=12h
PORTAL_ACCESS_TOKEN_TTL=15m
PORTAL_REFRESH_TOKEN_TTL_DAYS=30
PORTAL_REFRESH_REUSE_GRACE_SECONDS=5
PORTAL_PASSWORD_RESET_TTL_MINUTES=60
WEB_ANALYTICS_RETENTION_DAYS=90
OWNER_WEB_ANALYTICS_ENABLED=true
OWNER_REAL_USER_MONITORING_ENABLED=true
ADMIN_WEB_ANALYTICS_VIEW_ENABLED=true
WEB_REMEMBER_LOGIN_ENABLED=true
STORE_SNAPSHOT_ROOT=./data
STORE_SNAPSHOT_MAX_BYTES=536870912
STORE_SNAPSHOT_RETAIN_PREVIOUS=2
STORE_SCHEMA_MIN_VERSION=27
STORE_SCHEMA_MAX_VERSION=27
STORE_CLIENT_CACHE_MAX=25
STORE_CLIENT_IDLE_MILLISECONDS=600000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Production example: CORS_ORIGINS=https://vmjamdocuai.cloud,https://admin.vmjamdocuai.cloud
PORTAL_WEB_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Production example: PORTAL_WEB_ORIGINS=https://vmjamdocuai.cloud
ADMIN_WEB_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Production example: ADMIN_WEB_ORIGINS=https://admin.vmjamdocuai.cloud
PLATFORM_BACKUP_ROOT=./backups
PORTAL_SCHEDULED_REPORTS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=VMJAM Reports <reports@example.com>
RESEND_WEBHOOK_SECRET=
BILLING_COMPANY_NAME=VMJAMTECH
BILLING_COMPANY_ADDRESS=Your registered business address
BILLING_SUPPORT_EMAIL=billing@example.com
BILLING_SUPPORT_PHONE=Your billing phone number
# Separate multiple payment instructions with a vertical bar (|). Keep real account numbers only in the VPS .env.
BILLING_PAYMENT_INSTRUCTIONS=Contact us for payment instructions.
BILLING_SIGNATORY_NAME=VON MC JIM A. MERCADO
BILLING_SIGNATORY_TITLE=SERVICE PROPRIETOR
PLATFORM_BACKUP_RETAIN_DAYS=30
POSTGRES_BIN=C:/Program Files/PostgreSQL/16/bin
